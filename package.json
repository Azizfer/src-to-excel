{
  "name": "screenshot-to-excel",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a screenshot of a table into an editable .xlsx / .csv spreadsheet.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs",
    "smoke": "node scripts/smoke-extract.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-textract": "^3.1131.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.11",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
